# Copy to .env for local development:  cp .env.example .env
APP_NAME=AgentHub
APP_URL=http://localhost:8000
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# From the Shopify Dev Dashboard → your app → Settings
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_BASE_SCOPES=read_products

DATABASE_URL=postgres://localhost:5432/agenthub
REDIS_URL=redis://localhost:6379/0

# Fernet key for encrypting Shopify tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the new key first, comma, old key.
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# Model IDs shown in the Agent Studio (comma-separated)
ALLOWED_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
DEFAULT_MODEL=claude-sonnet-5-5

# Empty in dev = login emails are printed in the terminal.
# (Keep comments on their own line: values may not contain inline comments.)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=AgentHub <login@example.com>
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
